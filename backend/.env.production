# Production Environment Configuration for Render Deployment

# Database Configuration (Use MongoDB Atlas for production)
# IMPORTANT: Set this as environment variable in Render, NOT in code!
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/email-deliverability-tool?retryWrites=true&w=majority

# Client Origins (Frontend URLs - IMPORTANT for CORS)
CLIENT_ORIGIN=https://email-spam-report-tool-1-oncd.onrender.com,http://localhost:5173

# Gmail API Configuration (Optional - enables real API integration)
GMAIL_CLIENT_ID=your_gmail_client_id_here
GMAIL_CLIENT_SECRET=your_gmail_client_secret_here
GMAIL_REDIRECT_URI=urn:ietf:wg:oauth:2.0:oob
GMAIL_REFRESH_TOKEN=your_refresh_token_here
GMAIL_TEST_EMAIL=yourgmail@gmail.com

# Gmail SMTP Configuration (Required for automatic email sending)
GMAIL_EMAIL=your_gmail_address@gmail.com
GMAIL_APP_PASSWORD=your_gmail_app_password

# TestMail.app Configuration (GitHub Student Developer)
TESTMAIL_API_KEY=b642b37e-10a7-480b-8fd0-5e6be464a650
TESTMAIL_NAMESPACE=jckwp
TESTMAIL_BASE_URL=https://api.testmail.app

# Server Configuration
PORT=5000
NODE_ENV=production